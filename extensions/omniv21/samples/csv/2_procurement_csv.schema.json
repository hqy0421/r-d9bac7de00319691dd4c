{
    "parser_settings": {
        "version": "omni.2.1",
        "file_format_type": "csv"
    },
    "file_declaration": {
        "delimiter": ",",
        "header_row_index": 1,
        "data_row_index": 2,
        "columns": [
            { "name": "po_number", "header_aliases": [ "PO Number", "PO#" ] },
            { "name": "sku", "header_aliases": [ "SKU", "Item Code" ] },
            { "name": "quantity", "header_aliases": [ "Qty" ] },
            { "name": "unit_price", "header_aliases": [ "Unit Price", "Price" ] }
        ]
    },
    "transform_declarations": {
        "FINAL_OUTPUT": { "object": {
            "po": { "xpath": "po_number" },
            "sku": { "xpath": "sku" },
            "quantity": { "xpath": "quantity", "type": "int" },
            "unit_price": { "xpath": "unit_price", "type": "float" },
            "total": { "custom_func": {
                "name": "javascript",
                "args": [
                    { "const": "Math.round(q * p * 100) / 100" },
                    { "const": "q" }, { "xpath": "quantity", "type": "float" },
                    { "const": "p" }, { "xpath": "unit_price", "type": "float" }
                ]
            }}
        }}
    }
}
